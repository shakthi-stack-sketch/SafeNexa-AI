# ==============================================================================
# OIL SIF Intelligence — Environment Configuration
# ==============================================================================

# [DATABASE CONFIGURATION]
# Dual-Mode Operation:
# 1. If DATABASE_URL is set to a valid PostgreSQL connection string, Prisma ORM
#    will connect to PostgreSQL.
# 2. If DATABASE_URL is commented out or empty, the platform automatically
#    falls back to local JSON file storage (data/database.json & data/users.json).

# --- OPTION A: Managed Cloud PostgreSQL (Recommended - Neon / Supabase) ---
# Neon:
# DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Supabase:
# DATABASE_URL="postgresql://postgres:password@db.sample.supabase.co:5432/postgres"

# --- OPTION B: Local PostgreSQL Server ---
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oil_sif_db?schema=public"

# --- OPTION C: Default / Standalone (Fallback JSON storage) ---
# (Leave blank or unset to run in zero-dependency JSON mode)
# DATABASE_URL=""

# [NLP ENGINE SERVICE URL]
NEXT_PUBLIC_NLP_API_URL="http://localhost:8000"

# [SESSION AUTHENTICATION SECRET]
SESSION_SECRET="oil-sif-enterprise-secure-jwt-key-2026"
